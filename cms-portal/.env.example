# =============================================================================
# WDPCS Website Administration Portal & CMS - Environment Configuration
# Copy this file to .env and configure strong secrets before running.
# NEVER commit .env to GitHub or expose secrets in public website code.
# =============================================================================

# Server
NODE_ENV=development
CMS_HOST=127.0.0.1
CMS_PORT=4000
TRUST_PROXY=0

# Canonical URLs
# Production examples:
#   ADMIN_BASE_URL=https://admin.wdpcs.in
#   PUBLIC_SITE_ORIGINS=https://www.wdpcs.in,https://wdpcs.github.io
ADMIN_BASE_URL=http://localhost:4000
PUBLIC_SITE_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://www.wdpcs.in,https://wdpcs.github.io

# Security Secrets (Use minimum 32-byte random hex strings in production)
SESSION_SECRET=change-this-to-a-64-char-random-hex-secret-in-production
CSRF_SECRET=change-this-to-another-64-char-random-hex-secret

# Session & Auth Hardening
SESSION_MAX_AGE_MINUTES=480
SESSION_IDLE_TIMEOUT_MINUTES=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_RESET_EXPIRY_MINUTES=30
ALLOW_DEV_RESET_PREVIEW=true

# Storage Paths (relative to cms-portal/ unless absolute)
DB_PATH=./storage/database/wdpcs_cms.sqlite
UPLOAD_DIR=./storage/uploads
BACKUP_DIR=./backups

# Initial Super Admin Bootstrap (used only by `npm run seed` when zero users exist)
# Leave ADMIN_INIT_PASSWORD empty to auto-generate a one-time strong password on seed.
ADMIN_INIT_USERNAME=superadmin
ADMIN_INIT_EMAIL=admin@wdpcs.in
ADMIN_INIT_NAME=Society System Administrator
ADMIN_INIT_PASSWORD=

# Cookie Settings (Set COOKIE_SECURE=true in HTTPS production)
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# Optional Approval Workflow Setting Default (true | false)
DEFAULT_REQUIRE_APPROVAL_FINANCIAL=true
DEFAULT_REQUIRE_APPROVAL_CONTENT=false

